# ============================================================
# AMBIENTE DE TRABALHO
# ============================================================
# Choices: local | production
# O sistema detecta automaticamente qual banco usar
# - local = usa DB_LOCAL_* (desenvolvimento)
# - production = usa DB_ONLINE_* (produção/cPanel)
APP_ENV=local

# ============================================================
# URL BASE DO SISTEMA
# ============================================================
# O sistema detecta automaticamente a pasta onde está instalado
# - local: http://localhost/novoframework/public
# - production subpasta: https://seudominio.com/novoframework
# - production raiz: https://seudominio.com
BASE_URL=http://localhost/novoframework/public

# ============================================================
# DATABASE LOCAL (desenvolvimento)
# ============================================================
# Usado quando APP_ENV=local
DB_LOCAL_HOST=localhost
DB_LOCAL_PORT=3306
DB_LOCAL_NAME=novoframework
DB_LOCAL_USER=root
DB_LOCAL_PASS=Profox123

# ============================================================
# DATABASE ONLINE (produção - cPanel)
# ============================================================
# Usado quando APP_ENV=production
# Preencha com os dados do seu banco no cPanel
DB_ONLINE_HOST=localhost
DB_ONLINE_PORT=3306
DB_ONLINE_NAME=seudominio_novoframework
DB_ONLINE_USER=seudominio_admin
DB_ONLINE_PASS=sua_senha_aqui

# ============================================================
# FTP PRODUÇÃO (deploy via FTP)
# ============================================================
# Configurações para upload via FTP ao servidor de produção
# Preencha apenas quando for fazer deploy
FTP_HOST=ftp.seudominio.com
FTP_PORT=21
FTP_USER=seudominio_admin
FTP_PASS=sua_senha_ftp
FTP_PATH=/public_html/novoframework

# ============================================================
# CONFIGURAÇÕES
# ============================================================
DB_CHARSET=utf8mb4
SESSION_LIFETIME=120